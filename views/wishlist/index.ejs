<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <h2>My Wishlist</h2>
    <hr>
    
    <% if(wishlistItems.length === 0) { %>
        <div class="col-12 text-center mt-5">
            <i class="fa-regular fa-heart" style="font-size: 5rem; color: #ccc;"></i>
            <h4 class="mt-3">Your wishlist is empty</h4>
            <p>Start adding your favorite listings!</p>
            <a href="/listings" class="btn btn-primary mt-3">Explore Listings</a>
        </div>
    <% } else { %>
        <div class="row row-cols-lg-3 mt-3 row-cols-md-2 row-cols-sm-1">
            <% for(let listing of wishlistItems){ %> 
                <div class="col mb-4">
                    <div class="card show-card">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <img src="<%=listing.image.url %>" class="card-img-top" style="height: 20rem;" alt="listing_image">
                            <div class="card-img-overlay"></div>
                        </a>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <a href="/listings/<%= listing._id %>" class="listing-link">
                                        <p class="card-text">
                                            <b><%= listing.title %></b><br>
                                            &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                                        </p>
                                    </a>
                                </div>
                                <form method="POST" action="/wishlist/remove/<%= listing._id %>?_method=DELETE" class="d-inline">
                                    <button type="submit" class="btn btn-link text-danger p-0">
                                        <i class="fa-solid fa-heart" style="font-size: 1.5rem;"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>
