<nav class="navbar navbar-expand-md sticky-top">
  <div class="container px-2">
    <a class="navbar-brand me-4" href="/listings">
      <img src="/images/logo-white.png" alt="Stayvio" style="height:50px; width:auto;">
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <div class="navbar-nav me-auto">
        <a class="nav-link" href="/listings">Home</a>
        <a class="nav-link" href="/listings">Explore</a>
        <% if(currUser){ %>
          <a class="nav-link" href="/bookings">My Bookings</a>
          <a class="nav-link" href="/wishlist">Wishlist</a>
        <% } %>
      </div>
      <div class="d-flex align-items-center gap-2">
        <% if(currUser){ %>
          <a href="/listings/new" class="btn-list-space">List Your Space</a>
        <% } else{ %>
          <button onclick="openAuthModal('login')" class="btn-list-space" style="border: none; cursor: pointer;">List Your Space</button>
        <% } %>
        <% if(!currUser){ %>
          <button onclick="openAuthModal('login')" class="btn-nav-login">Login / Sign Up</button>
        <% } else { %>
          <a href="/logout" class="btn-nav-login">Log Out</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<!-- BACKDROP -->
<div id="authModalBackdrop" class="auth-modal-backdrop" onclick="closeAuthModal()"></div>

<!-- AUTH MODAL -->
<div id="authModal" class="auth-modal-box">
  <div class="auth-modal-inner">

    <!-- LEFT IMAGE -->
    <div class="auth-modal-left">
      <div class="auth-left-overlay">
        <img src="/images/logo-white.png" alt="Stayvio" style="height:36px; width:auto; display:block; object-fit:contain; filter:brightness(0) invert(0);">
        <div class="auth-trust-badges">
          <div class="trust-item">
            <i class="fa-solid fa-shield-halved"></i>
            <div>
              <div class="trust-title">Secure Bookings</div>
              <div class="trust-sub">Encrypted payments & verified hosts</div>
            </div>
          </div>
          <div class="trust-item">
            <i class="fa-solid fa-headset"></i>
            <div>
              <div class="trust-title">24/7 Support</div>
              <div class="trust-sub">Real people, real help</div>
            </div>
          </div>
          <div class="trust-item">
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <div class="trust-title">Verified Hosts</div>
              <div class="trust-sub">Trusted homes and hosts</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT FORM -->
    <div class="auth-modal-right">
      <button class="auth-modal-close" onclick="closeAuthModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="auth-toggle">
        <button class="toggle-btn active" id="loginToggle" onclick="switchTab('login')">Login</button>
        <button class="toggle-btn" id="signupToggle" onclick="switchTab('signup')">Sign Up</button>
      </div>

      <!-- LOGIN -->
      <div id="loginForm" class="active-form">
        <p class="auth-welcome">
          <i class="fa-solid fa-circle-check me-1" style="color:#E07B39;"></i>
          Welcome back — enter your credentials to continue.
        </p>
        <form action="/login" method="POST">
          <div class="auth-field">
            <label>Username</label>
            <input type="text" name="username" class="auth-input" placeholder="Your username" required />
          </div>
          <div class="auth-field">
            <label>Password</label>
            <input type="password" name="password" class="auth-input" placeholder="Enter your password" required />
          </div>
          <div class="auth-row-between">
            <label class="auth-checkbox"><input type="checkbox"> Remember me</label>
            <a href="#" class="auth-forgot">Forgot password?</a>
          </div>
          <button type="submit" class="auth-submit-btn">Log In</button>
        </form>
        <div class="auth-divider"><span>Or continue with</span></div>
        <div class="social-btns">
          <button class="social-btn"><i class="fa-brands fa-google"></i> Google</button>
          <button class="social-btn"><i class="fa-brands fa-apple"></i> Apple</button>
          <button class="social-btn"><i class="fa-brands fa-facebook"></i> Facebook</button>
        </div>
      </div>

      <!-- SIGNUP -->
      <div id="signupForm">
        <form action="/signup" method="POST">
          <div class="auth-field">
            <label>Username</label>
            <input type="text" name="username" class="auth-input" placeholder="Choose a username" required />
          </div>
          <div class="auth-field">
            <label>Email</label>
            <input type="email" name="email" class="auth-input" placeholder="you@example.com" required />
          </div>
          <div class="auth-field">
            <label>Password</label>
            <input type="password" name="password" class="auth-input" placeholder="At least 8 characters" required />
          </div>
          <div class="auth-field">
            <label>I want to</label>
            <div class="d-flex gap-2 mt-1">
              <label class="role-option">
                <input type="radio" name="role" value="guest" checked>
                <span>Travel & Book</span>
              </label>
              <label class="role-option">
                <input type="radio" name="role" value="host">
                <span>List My Space</span>
              </label>
            </div>
          </div>
          <button type="submit" class="auth-submit-btn">Create Account</button>
        </form>
        <div class="auth-divider"><span>Or sign up using</span></div>
        <div class="social-btns">
          <button class="social-btn"><i class="fa-brands fa-google"></i> Google</button>
          <button class="social-btn"><i class="fa-brands fa-apple"></i> Apple</button>
          <button class="social-btn"><i class="fa-brands fa-facebook"></i> Facebook</button>
        </div>
      </div>

    </div><!-- end auth-modal-right -->
  </div><!-- end auth-modal-inner -->
</div><!-- end auth-modal-box -->


