<% layout("/layouts/boilerplate") %>

<div class="lform-page">
  <div class="container py-4">
    <div class="lform-wrap">

      <div class="lform-header">
        <h2 class="lform-title">Edit Listing</h2>
        <p class="lform-sub">Update your property details</p>
      </div>

      <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

        <!-- Basic Info -->
        <div class="lform-section">
          <div class="lform-section-title">Basic Information</div>

          <div class="lform-field">
            <label>Property Title</label>
            <input type="text" name="listing[title]" class="lform-input" value="<%= listing.title %>" required/>
          </div>

          <div class="lform-field">
            <label>Description</label>
            <textarea name="listing[description]" class="lform-input" rows="4" required><%= listing.description %></textarea>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="lform-field">
                <label>Property Type</label>
                <select name="listing[propertyType]" class="lform-input">
                  <% ['Villa','Homestay','Cabin','Beach House','Heritage Haveli','Apartment','Farm Stay','Treehouse','Houseboat','Tent/Glamping'].forEach(t => { %>
                    <option value="<%= t %>" <%= listing.propertyType === t ? 'selected' : '' %>><%= t %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="lform-field">
                <label>Category</label>
                <select name="listing[category]" class="lform-input">
                  <% ['Trending','Hill Stations','Beaches','Heritage','Backwaters','Forests','Desert','Pilgrimage','Farms','Houseboats'].forEach(c => { %>
                    <option value="<%= c %>" <%= listing.category === c ? 'selected' : '' %>><%= c %></option>
                  <% }) %>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Location & Pricing -->
        <div class="lform-section">
          <div class="lform-section-title">Location & Pricing</div>
          <div class="row g-3">
            <div class="col-md-6">
              <div class="lform-field">
                <label>Location / City</label>
                <input type="text" name="listing[location]" class="lform-input" value="<%= listing.location %>" required/>
              </div>
            </div>
            <div class="col-md-6">
              <div class="lform-field">
                <label>Country</label>
                <input type="text" name="listing[country]" class="lform-input" value="<%= listing.country %>" required/>
              </div>
            </div>
            <div class="col-md-4">
              <div class="lform-field">
                <label>Price per night (₹)</label>
                <input type="number" name="listing[price]" class="lform-input" value="<%= listing.price %>" required/>
              </div>
            </div>
            <div class="col-md-4">
              <div class="lform-field">
                <label>Cleaning Fee (₹)</label>
                <input type="number" name="listing[cleaningFee]" class="lform-input" value="<%= listing.cleaningFee || 0 %>"/>
              </div>
            </div>
            <div class="col-md-4">
              <div class="lform-field">
                <label>Service Fee (₹)</label>
                <input type="number" name="listing[serviceFee]" class="lform-input" value="<%= listing.serviceFee || 0 %>"/>
              </div>
            </div>
          </div>
        </div>

        <!-- Property Details -->
        <div class="lform-section">
          <div class="lform-section-title">Property Details</div>
          <div class="row g-3">
            <div class="col-md-4">
              <div class="lform-field">
                <label>Max Guests</label>
                <input type="number" name="listing[maxGuests]" class="lform-input" value="<%= listing.maxGuests || 2 %>" min="1"/>
              </div>
            </div>
            <div class="col-md-4">
              <div class="lform-field">
                <label>Bedrooms</label>
                <input type="number" name="listing[bedrooms]" class="lform-input" value="<%= listing.bedrooms || 1 %>" min="0"/>
              </div>
            </div>
            <div class="col-md-4">
              <div class="lform-field">
                <label>Bathrooms</label>
                <input type="number" name="listing[bathrooms]" class="lform-input" value="<%= listing.bathrooms || 1 %>" min="0"/>
              </div>
            </div>
          </div>

          <div class="lform-field mt-3">
            <label>Cancellation Policy</label>
            <select name="listing[cancellationPolicy]" class="lform-input">
              <option value="Flexible" <%= listing.cancellationPolicy === 'Flexible' ? 'selected' : '' %>>Flexible — Full refund 48hrs before check-in</option>
              <option value="Moderate" <%= listing.cancellationPolicy === 'Moderate' ? 'selected' : '' %>>Moderate — Full refund 24hrs before check-in</option>
              <option value="Strict" <%= listing.cancellationPolicy === 'Strict' ? 'selected' : '' %>>Strict — No refund within 7 days</option>
            </select>
          </div>
        </div>

        <!-- Amenities -->
        <div class="lform-section">
          <div class="lform-section-title">Amenities</div>
          <div class="lform-amenities-grid">
            <% ['WiFi','Pool','Kitchen','AC','Parking','Bonfire','Heater','Mountain View','Sea View','Forest View','Breakfast','Meals Included','Yoga Deck','Hot Water','Garden','City View','Washer','TV'].forEach(a => { %>
              <label class="lform-amenity-check">
                <input type="checkbox" name="listing[amenities]" value="<%= a %>" <%= listing.amenities && listing.amenities.includes(a) ? 'checked' : '' %>>
                <span><%= a %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- House Rules -->
        <div class="lform-section">
          <div class="lform-section-title">House Rules</div>
          <textarea name="listing[houseRulesText]" class="lform-input" rows="3" placeholder="One rule per line"><%= listing.houseRules ? listing.houseRules.join('\n') : '' %></textarea>
        </div>

        <!-- Extra Info -->
        <div class="lform-section">
          <div class="lform-section-title">Additional Information</div>
          <div class="lform-field">
            <label>Accessibility Notes</label>
            <input type="text" name="listing[accessibilityNotes]" class="lform-input" value="<%= listing.accessibilityNotes || '' %>"/>
          </div>
          <div class="lform-field">
            <label>Check-in Instructions</label>
            <input type="text" name="listing[checkInInstructions]" class="lform-input" value="<%= listing.checkInInstructions || '' %>"/>
          </div>
        </div>

        <!-- Image -->
        <div class="lform-section">
          <div class="lform-section-title">Property Image</div>
          <div class="lform-field">
            <label>Current Image</label>
            <img src="<%= changedImgUrl %>" alt="current" style="height:120px; border-radius:8px; object-fit:cover; margin-bottom:0.8rem; display:block;">
            <label>Upload New Image (optional)</label>
            <input type="file" name="listing[image]" class="lform-input"/>
          </div>
        </div>

        <button type="submit" class="lform-submit-btn">
          <i class="fa-solid fa-pen me-2"></i>Update Listing
        </button>

      </form>
    </div>
  </div>
</div>

<style>
.lform-page { background: var(--color-bg); min-height: 80vh; }
.lform-wrap { max-width: 780px; margin: 0 auto; }
.lform-header { margin-bottom: 2rem; }
.lform-title { font-size: 1.6rem; font-weight: 700; color: var(--color-text); margin: 0; }
.lform-sub { font-size: 0.88rem; color: var(--color-muted); margin: 0.3rem 0 0; }
.lform-section { background: var(--color-white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 1.5rem; margin-bottom: 1.2rem; }
.lform-section-title { font-weight: 700; font-size: 0.95rem; color: var(--color-text); margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #f0e8dc; }
.lform-field { margin-bottom: 1rem; }
.lform-field:last-child { margin-bottom: 0; }
.lform-field label { display: block; font-size: 0.82rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.3rem; }
.lform-hint { font-size: 0.78rem; color: var(--color-muted); margin-bottom: 0.8rem; }
.lform-input { width: 100%; border: 1.5px solid #e0d5c8; border-radius: 8px; padding: 0.6rem 0.9rem; font-family: var(--font-main); font-size: 0.88rem; color: var(--color-text); background: var(--color-bg); outline: none; transition: border 0.2s; }
.lform-input:focus { border-color: var(--color-nav); }
.lform-amenities-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.5rem; }
.lform-amenity-check { display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--color-text); cursor: pointer; padding: 0.4rem 0.6rem; border: 1.5px solid #e0d5c8; border-radius: 8px; transition: border 0.15s, background 0.15s; }
.lform-amenity-check:has(input:checked) { border-color: var(--color-nav); background: #f0f4e8; font-weight: 600; }
.lform-amenity-check input { accent-color: var(--color-nav); }
.lform-submit-btn { width: 100%; background: var(--color-cta); color: white; border: none; border-radius: 10px; padding: 0.9rem; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: var(--font-main); transition: background 0.2s; margin-top: 0.5rem; }
.lform-submit-btn:hover { background: #c9692e; }
</style>
