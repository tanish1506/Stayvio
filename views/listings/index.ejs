<% layout("/layouts/boilerplate") -%>
<style>
    #filters{
        /* margin-top: 1rem; */
        display: flex;
        flex-wrap: wrap;
        
        align-items: center;
    }
    .filter-link{
        text-decoration: none;
        color: inherit;
    }
    .filter{
        text-align: center;
        margin: 1rem;
        opacity: 0.5;
        transition: opacity 0.3s;
    }
    .filter:hover{
        opacity: 1;
        cursor: pointer;
    }
    .active-filter{
        opacity: 1 !important;
        border-bottom: 2px solid #fe424d;
    }
    .filter p {
        font-size: 0.9rem;
    }
    .tax-info{
        display: none;
    }
    .tax-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        padding: 1rem;
        height: 3.5rem;
        margin-left: 3rem;
        display: flex;
        align-items: center;
    }

</style>
    
    <!-- <form method="get" action="/listings/new">
        <button>Create New Listing</button>
    </form> -->
<div id="filters">
    <a href="/listings" class="filter-link">
        <div class="filter <%= !selectedCategory ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
    </a>
    <a href="/listings?category=Rooms" class="filter-link">
        <div class="filter <%= selectedCategory === 'Rooms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
    </a>
    <a href="/listings?category=Mountains" class="filter-link">
        <div class="filter <%= selectedCategory === 'Mountains' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
    </a>
    <a href="/listings?category=Iconic Cities" class="filter-link">
        <div class="filter <%= selectedCategory === 'Iconic Cities' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
    </a>
    <a href="/listings?category=Castles" class="filter-link">
        <div class="filter <%= selectedCategory === 'Castles' ? 'active-filter' : '' %>">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
    </a>
    <a href="/listings?category=Amazing Pools" class="filter-link">
        <div class="filter <%= selectedCategory === 'Amazing Pools' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-water-ladder"></i></div>
            <p>Amazing Pools</p>
        </div>
    </a>
    <a href="/listings?category=Camping" class="filter-link">
        <div class="filter <%= selectedCategory === 'Camping' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-tents"></i></div>
            <p>Camping</p>
        </div>
    </a>
    <a href="/listings?category=Farms" class="filter-link">
        <div class="filter <%= selectedCategory === 'Farms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
    </a>
    <a href="/listings?category=Arctic" class="filter-link">
        <div class="filter <%= selectedCategory === 'Arctic' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-snowman"></i></div>
            <p>Arctic</p>
        </div>
    </a>
    <a href="/listings?category=Domes" class="filter-link">
        <div class="filter <%= selectedCategory === 'Domes' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-landmark-dome"></i></div>
            <p>Domes </p>
        </div>
    </a>
    <a href="/listings?category=Boats" class="filter-link">
        <div class="filter <%= selectedCategory === 'Boats' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </div>
    </a>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display Total after taxes</label>
        </div>
    </div>
</div>
<div class="row row-cols-lg-3 mt-1 row-cols-md-2 row-cols-sm-1">

    <% for(let listing of allListings){ %> 
        <div class="col mb-4">
            <div class="card show-card">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <img src="<%=listing.image.url %>" class="card-img-top" style="height: 20rem;" alt="listing_image">
                    <div class="card-img-overlay"></div>
                </a>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <a href="/listings/<%= listing._id %>" class="listing-link" style="flex: 1;">
                            <p class="card-text">
                                <b><%= listing.title %></b><br>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                                <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
                            </p>
                        </a>
                        <% if(currUser) { %>
                            <% 
                            const isInWishlist = userWishlist.includes(listing._id.toString());
                            const action = isInWishlist ? 'remove' : 'add';
                            const heartIcon = isInWishlist ? 'fa-solid' : 'fa-regular';
                            const method = isInWishlist ? 'DELETE' : 'POST';
                            %>
                            <form method="POST" action="/wishlist/<%= action %>/<%= listing._id %><%= isInWishlist ? '?_method=DELETE' : '' %>" class="wishlist-form-<%= listing._id %>" style="margin-left: 10px; position: relative; z-index: 10;">
                                <button type="button" onclick="event.stopPropagation(); event.preventDefault(); this.closest('form').submit();" class="btn btn-link text-danger p-0" style="border: none; background: none; cursor: pointer; position: relative; z-index: 10;">
                                    <i class="<%= heartIcon %> fa-heart" style="font-size: 1.5rem; pointer-events: none;"></i>
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
            
</div>
<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=> {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline" ){
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }
        }
    });
</script>