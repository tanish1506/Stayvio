<% layout("/layouts/boilerplate")%>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="show-page">
  <div class="container py-3">

    <!-- Breadcrumb -->
    <div class="show-breadcrumb">
      <a href="/listings">Search results</a> /
      <a href="/listings"><%= listing.location %></a> /
      <span><%= listing.title %> &mdash; Listing</span>
    </div>

    

    <!-- Two Column Layout -->
    <div class="row g-4">

      <!-- LEFT COLUMN -->
      <div class="col-lg-7">

        <!-- Hero Image -->
        <div class="image-gallery-card">
           <img
           id="mainImage"
           src="<%= listing.image.url %>"
           alt="<%= listing.title %>"
           class="show-hero"
           />
           <!-- thumbnail images strip -->
           <% if(listing.images && listing.images.length > 0){ %>
            <div class="img-thumbnail-strip">
              <img src="<%= listing.image.url %>" onclick="changeImage(this)" alt="main" class="img-thumb active-thumb">
              <% for(let img of listing.images){ %>
                <img src="<%= img.url %>" onclick="changeImage(this)" class="img-thumb" alt="listing image">
                <% } %>
              </div>
              <% } %>
          </div>
        <!-- Title & Host -->
        <h1 class="show-title"><%= listing.title %></h1>
        <p style="font-size:0.88rem; color:var(--color-muted); margin-bottom:0.5rem;">
          <i class="fa-solid fa-location-dot me-1" style="color:var(--color-cta);"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
        <p style="font-size:0.82rem; color:var(--color-muted);">
          <% if(listing.maxGuests){ %><%= listing.maxGuests %> guests &nbsp;&bull;&nbsp;<% } %>
          <% if(listing.bedrooms){ %><%= listing.bedrooms %> bedrooms &nbsp;&bull;&nbsp;<% } %>
          <% if(listing.bathrooms){ %><%= listing.bathrooms %> baths<% } %>
        </p>

        <div class="show-host">
          <div class="host-avatar-placeholder">
            <%= listing.owner.username.charAt(0).toUpperCase() %>
          </div>
          <div>
            <div style="font-weight:600; font-size:0.9rem;">Hosted by <%= listing.owner.username %></div>
            <div style="font-size: 0.78rem; color: var(--color-muted);">
              <% if(listing.owner.superhost){ %>
                Superhost &bull;
              <% } %>

              <% if(listing.owner.responseRate){ %> 
                Responds within <%= listing.owner.responseRate %>% &bull; 
              <% } %>

              Host since <%= listing.owner.hostSince ? new Date(listing.owner.hostSince).getFullYear() : 'recently' %>
            </div>
          </div>
          <span class="contact-host-link">Contact Host</span>
        </div>

        <!-- Key Highlights -->
        <div class="highlights-card">
          <h6>Key highlights</h6>
          <div class="row">
            <% const amenityIcons = {'WiFi': 'fa-wifi','Pool': 'fa-water-ladder','Kitchen': 'fa-kitchen-set','AC': 'fa-snowflake','Parking': 'fa-car','Bonfire': 'fa-fire','Heater': 'fa-temperature-high' ,'Mountain View': 'fa-mountain','Sea View': 'fa-water','Forest View': 'fa-tree','Lake View': 'fa-water','River View': 'fa-water','Breakfast': 'fa-mug-hot','Meals Included': 'fa-utensils','Yoga Deck': 'fa-person-praying','Hot Water': 'fa-droplet','Garden': 'fa-seedling','City View': 'fa-city'}; %>
            <% const highlights = listing.amenities ? listing.amenities.slice(0,4) : [] %>
            <% for(let amenity of highlights){ %>
              <div class="col-6">
                <div class="highlight-item">
                  <i class="fa-solid <%= amenityIcons[amenity] || 'fa-check' %>"></i>
                  <div>
                    <div class="h-label"><%= amenity %></div>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- About -->
        <div class="section-card">
          <h5>About this space</h5>
          <p><%= listing.description %></p>
        </div>

        <!-- Amenities -->
        <% if(listing.amenities && listing.amenities.length > 0){ %>
        <div class="section-card">
          <h5>Amenities</h5>
          <div>
            <% for(let amenity of listing.amenities){ %>
              <span class="amenity-badge">
                <i class="fa-solid fa-check"></i> <%= amenity %>
              </span>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- House Rules -->
        <div class="section-card">
          <h5>House rules</h5>
          <% if(listing.houseRules && listing.houseRules.length > 0){ %>
            <ul class="house-rules-list">
              <% for(let rule of listing.houseRules){ %>
                <li><%= rule %></li>
              <% } %>
            </ul>
          <% } else { %>
            <ul class="house-rules-list">
              <li>No smoking inside the property</li>
              <li>No unregistered parties or events</li>
              <li>Quiet hours after 10:00 PM</li>
            </ul>
          <% } %>
        </div>

        <!-- Location / Map -->
        <div class="section-card">
          <h5>Location</h5>
          <div id="map"></div>
          <p style="font-size:0.78rem; color:var(--color-muted); margin-top:0.5rem;">
            <%= listing.location %>, <%= listing.country %>
          </p>
        </div>

        <!-- Reviews -->
        <div class="section-card">
          <div class="review-summary">
            <i class="fa-solid fa-star rating-star"></i>
            <span class="rating-num">
              <% if(listing.reviews.length > 0){ %>
                <%= (listing.reviews.reduce((sum,r) => sum + r.rating , 0) / listing.reviews.length).toFixed(1) %>
              <% } else { %>
                New
              <% } %>
            </span>
            <span class="review-count"><%= listing.reviews.length %> reviews</span>
          </div>

          <% if(listing.reviews.length > 0){ %>
            <% for(let review of listing.reviews){ %>
              <div class="review-item">
                <div class="reviewer-info">
                  <div class="reviewer-avatar">
                    <%= review.author.username.charAt(0).toUpperCase() %>
                  </div>
                  <div style="flex:1;">
                    <div class="reviewer-name">@<%= review.author.username %></div>
                    <div class="reviewer-date">Stayvio Guest</div>
                  </div>
                  <div style="display:flex; align-items:center; gap:0.5rem;">
                    <span style="font-weight:600; font-size:0.85rem; color:var(--color-white); background:var(--color-cta); padding:0.2rem 0.5rem; border-radius:6px;"><%= review.rating %>.0</span>
                    <% if(currUser && review.author._id.equals(currUser._id)){ %>
                      <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button style="color:var(--color-muted); background:none; border:none; font-size:0.8rem; cursor:pointer;"></button>
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
                <p class="review-text mt-2"><%= review.comment %></p>
              </div>
            <% } %>
          <% } else { %>
            <p style="font-size:0.88rem; color:var(--color-muted);">No reviews yet. Be the first to review!</p>
          <% } %>
        </div>

        <!-- Add Review -->
        <% if(currUser){ %>
        <div class="add-review-card" id="review">
          <h5>Add a review</h5>
          <form novalidate class="needs-validation" method="post" action="/listings/<%= listing._id %>/reviews">
            <div class="mb-3">
              <label class="form-label" style="font-size:0.85rem; font-weight:600;">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label" style="font-size:0.85rem; font-weight:600;">Comment</label>
              <textarea name="review[comment]" id="comment" required class="form-control" rows="4" placeholder="Share your experience..."></textarea>
              <div class="invalid-feedback">Please add some comments for review</div>
            </div>
            <button class="btn btn-cta px-4">Submit Review</button>
          </form>
        </div>
        <% } %>

        <!-- Accessibilty & Check-in -->
         <% if(listing.accessibilityNotes || listing.checkInInstructions){ %>
          <div class="row g-3 mb-4">
            <% if(listing.accessibilityNotes){ %>
              <div class="col-md-6">
                <div class="section-card">
                  <h5>Accessibility notes</h5>
                  <p><%= listing.accessibilityNotes %></p>
                </div>
              </div>
            <% } %>

            <% if(listing.checkInInstructions){ %>
              <div class="col-md-6">
                <div class="section-card">
                  <h5>Check-in instructions</h5>
                  <p><%= listing.checkInInstructions %></p>
                </div>
              </div>
            <% } %>
          </div>
         <% } %>

        <!-- Owner Actions -->
        <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
        <div class="owner-actions mt-2 mb-4">
          <a class="btn btn-edit px-4" href="/listings/<%= listing._id %>/edit">
            <i class="fa-solid fa-pen me-1"></i> Edit Listing
          </a>
          <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-delete px-4" onclick="return confirm('Delete this listing?')">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
        <% } %>

      </div>

      <!-- RIGHT COLUMN — Booking Form -->
      <div class="col-lg-5 col-12">
        <div class="booking-card">
          <div class="price-line">
            &#8377;<%= listing.price.toLocaleString("en-IN") %>
            <span>/night</span>
          </div>
          <div class="secure-tag">
            <i class="fa-solid fa-shield-halved me-1" style="color:var(--color-nav);"></i>Secure booking
          </div>

          <% if(currUser && !listing.owner._id.equals(currUser._id)){ %>
            <form action="/listings/<%= listing._id %>/bookings" method="post" id="bookingForm">
              <div class="mb-3">
                <label class="form-label">Check-in</label>
                <input type="date" name="checkIn" id="checkIn" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Check-out</label>
                <input type="date" name="checkOut" id="checkOut" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Guests</label>
                <input type="number" name="guests" id="guests" class="form-control" min="1" max="<%= listing.maxGuests %>" value="1" required>
                <small style="font-size:0.78rem; color:var(--color-muted);">Max <%= listing.maxGuests %> guests</small>
              </div>

              <div id="priceSummary" class="price-breakdown d-none">
                <div class="d-flex justify-content-between mb-1">
                  <span id="nightsText">0 nights</span>
                  <span id="nightsPrice">&#8377;0</span>
                </div>
                <div class="total-row d-flex justify-content-between">
                  <span>Total</span>
                  <span id="totalPrice">&#8377;0</span>
                </div>
              </div>

              <button type="submit" class="btn-reserve">Reserve</button>
            </form>

          <% } else if(!currUser){ %>
            <p style="font-size:0.88rem; color:var(--color-muted); text-align:center; margin-bottom:1rem;">
              Login to book this listing
            </p>
            <a href="/login" class="btn-reserve text-center text-decoration-none d-block">Login to Book</a>

          <% } else { %>
            <p style="font-size:0.88rem; color:var(--color-muted); text-align:center;">
              You own this listing
            </p>
          <% } %>

          <div class="booking-footer-tags">
            <span><i class="fa-solid fa-lock"></i>Secure payment</span>
            <span><i class="fa-solid fa-leaf"></i>Free cancellation</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
    const listingPrice = <%= listing.price %>;
</script>
<script src="/js/map.js"></script>
<script>
  function changeImage(el){
    document.getElementById('mainImage').src = el.src;
    document.querySelectorAll('.img-thumb').forEach(t => t.classList.remove('active-thumb'));
    el.classList.add('active-thumb');
  }
</script>
