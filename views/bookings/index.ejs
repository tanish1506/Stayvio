<% layout('/layouts/boilerplate')%>

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Bookings</h2>
        <a href="/listings" class="btn btn-outline-primary">Explore More</a>
    </div>

    <!-- koi booking nhi  -->
    <% if(bookings.length === 0){ %>
        <div>
            <i class="fa-solid fa-calendar-xmark fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No Bookings yet!</h4>
            <p class="text-muted">Start exploring and book your perfect stay.</p>
            <a href="/listings" class="btn btn-primary mt-2">Explore Listings</a>
        </div>
    <% } else { %>
        <div class="row">
            <% for(let booking of bookings) { %>
                <div class="col-md-6 mb-4">

                    <div class="card h-100 shadow-sm">
                        <img src="<%= booking.listing.image.url %>" class="card-img-top" alt="<%= booking.listing.image.url %>" style="height: 200px; object-fit: cover;">

                        <div class="card-body pt-2 p-3">
                            <h5 class="card-title"><%= booking.listing.title %></h5>
                            <p class="text-muted mb-2">
                                📍 <%= booking.listing.location %>, <%= booking.listing.country %>
                            </p>

                            <div class="mb-2">
                                <small class="text-muted">
                                    📅 <%= new Date(booking.checkIn).toDateString() %> 
                                    → <%= new Date(booking.checkOut).toDateString() %>
                                </small>
                            </div>

                            <div class="mb-2">
                                <small class="text-muted">
                                    🌙 <%= booking.nights %> nights &nbsp;|&nbsp;
                                    👥 <%= booking.guests %> guests
                                </small>
                            </div>

                            <p class="fw-bold mb-2">
                                ₹<%= booking.totalPrice.toLocaleString('en-IN') %>
                            </p>


                            <% if(booking.status === 'confirmed') { %>
                                <span class="badge bg-success">✅ Confirmed</span>
                            <% } else if(booking.status === 'pending_payment') { %>
                                <span class="badge bg-warning text-dark">⏳ Payment Pending</span>
                            <% } else if(booking.status === 'cancelled') { %>
                                <span class="badge bg-danger">❌ Cancelled</span>
                            <% } else { %>
                                <span class="badge bg-secondary">✔️ Completed</span>
                            <% } %>

                        </div>

                        <div class="card-footer d-flex gap-2">
                            <a href="/bookings/<%= booking._id %>" class="btn btn-sm btn-success">View Details</a>

                            <% if(booking.status === 'pending_payment'){ %>
                                <a href="/bookings/<%= booking._id %>/payment" class="btn btn-sm btn-success">Pay Now</a>
                            <% } %>

                            <% if(booking.status !== 'cancelled' && booking.status !== 'completed'){ %>
                                <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this booking?')">
                                        Cancel
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %> 
        </div>
    <% } %>    

</div>