<% layout('/layouts/boilerplate') %>

    <div class="container my-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <!-- header -->
                    <div class="text-center mb-4">
                        <h2>Booking Details</h2>
                        <p class="text-muted"> Booking Id : <%= booking._id %>
                        </p>
                    </div>

                    <!-- status -->
                    <div class="text-center mb-3">
                        <% if(booking.status==='confirmed' ){ %>
                            <span class="badge bg-success fs-6">Booking Confirmed!!</span>
                        <% } else if(booking.status==='pending_payment' ){ %>
                            <span class="badge bg-warning text-dark fs-6">Payment Pending!!</span>
                        <% } else if(booking.status==='cancelled' ){ %>
                            <span class="badge bg-danger fs-6">Booking Cancelled!!</span>
                        <% } else{ %>
                            <span class="badge bg-secondary fs-6">Completed</span>
                        <% } %>
                    </div>

                    <!-- Listing details -->
                    <div class="card mb-4">
                        <img src="<%= booking.listing.image.url %>" class="card-img-top"
                            alt="<%= booking.listing.title %>" style="height: 250px; object-fit: cover;">
                        <div class="card-body">
                            <h4 class="card-title">
                                <%= booking.listing.title %>
                            </h4>
                            <p class="text-muted">
                                📍 <%= booking.listing.location %>, <%= booking.listing.country %>
                            </p>
                        </div>
                    </div>

                    <!-- booking details -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Booking Summary</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Check-in</strong></td>
                                    <td><%= new Date(booking.checkIn).toDateString() %></td>
                                </tr>
                                <tr>
                                    <td><strong>Check-out</strong></td>
                                    <td><%= new Date(booking.checkOut).toDateString() %></td>
                                </tr>
                                <tr>
                                    <td><strong>Guests</strong></td>
                                    <td><%= booking.guests %></td>
                                </tr>
                                <tr>
                                    <td><strong>Nights</strong></td>
                                    <td><%= booking.nights %></td>
                                </tr>
                                <tr>
                                    <td><strong>Price per night</strong></td>
                                    <td>₹<%= booking.listing.price.toLocaleString('en-IN') %></td>
                                </tr>
                                <tr class="table-active">
                                    <td><strong>Total Price</strong></td>
                                    <td><strong>₹<%= booking.totalPrice.toLocaleString('en-IN') %></strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>


                    <div class="d-flex gap-2 justify-content-center">
                        <a href="/bookings" class="btn btn-outline-secondary">
                            My Bookings
                        </a>
                        <% if(booking.status === 'pending_payment') { %>
                            <a href="/bookings/<%= booking._id %>/payment" class="btn btn-success">
                                Pay Now ₹<%= booking.totalPrice.toLocaleString('en-IN') %>
                            </a>
                        <% } %>
                        <% if(booking.status !== 'cancelled' && booking.status !== 'completed') { %>
                            <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST">
                                <button class="btn btn-outline-danger"
                                    onclick="return confirm('Are you sure you want to cancel?')">
                                    Cancel Booking
                                </button>
                            </form>
                        <% } %>
                    </div>


                </div>

            </div>
    </div>