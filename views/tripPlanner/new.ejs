<% layout("/layouts/boilerplate") %>

<!-- Hero Section -->
<div style="background: linear-gradient(135deg, #708238 0%, #4a5a20 50%, #2C2416 100%); min-height: 280px; display: flex; align-items: center; padding: 3rem 0; position: relative; overflow: hidden;">
  <!-- Background pattern -->
  <div style="position: absolute; inset: 0; opacity: 0.05; background-image: radial-gradient(circle at 20% 50%, white 1px, transparent 1px), radial-gradient(circle at 80% 20%, white 1px, transparent 1px); background-size: 60px 60px;"></div>
  
  <div class="container" style="position: relative; z-index: 1;">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.15); border-radius: 20px; padding: 0.3rem 1rem; margin-bottom: 1rem; backdrop-filter: blur(10px);">
          <i class="fa-solid fa-wand-magic-sparkles" style="color: #E07B39; font-size: 0.85rem;"></i>
          <span style="color: rgba(255,255,255,0.9); font-size: 0.8rem; font-weight: 500;">AI-Powered Trip Planning</span>
        </div>
        <h1 style="color: white; font-weight: 800; font-size: 2.4rem; line-height: 1.2; margin-bottom: 0.8rem;">
          Plan Your Perfect<br>
          <span style="color: #E07B39;">Budget Trip</span> with AI
        </h1>
        <p style="color: rgba(255,255,255,0.75); font-size: 1rem; margin: 0;">
          Tell us where you want to go and your budget — our AI builds a complete day-wise itinerary in seconds.
        </p>
      </div>
      <div class="col-lg-5 d-none d-lg-flex justify-content-end">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; max-width: 280px;">
          <div style="background: rgba(255,255,255,0.12); border-radius: 12px; padding: 1rem; text-align: center; backdrop-filter: blur(10px);">
            <div style="font-size: 1.5rem; margin-bottom: 0.3rem;">🗺️</div>
            <div style="color: white; font-size: 0.75rem; font-weight: 600;">Day-wise Plan</div>
          </div>
          <div style="background: rgba(255,255,255,0.12); border-radius: 12px; padding: 1rem; text-align: center; backdrop-filter: blur(10px);">
            <div style="font-size: 1.5rem; margin-bottom: 0.3rem;">💰</div>
            <div style="color: white; font-size: 0.75rem; font-weight: 600;">Budget Breakdown</div>
          </div>
          <div style="background: rgba(255,255,255,0.12); border-radius: 12px; padding: 1rem; text-align: center; backdrop-filter: blur(10px);">
            <div style="font-size: 1.5rem; margin-bottom: 0.3rem;">🏨</div>
            <div style="color: white; font-size: 0.75rem; font-weight: 600;">Stay Suggestions</div>
          </div>
          <div style="background: rgba(255,255,255,0.12); border-radius: 12px; padding: 1rem; text-align: center; backdrop-filter: blur(10px);">
            <div style="font-size: 1.5rem; margin-bottom: 0.3rem;">🎒</div>
            <div style="color: white; font-size: 0.75rem; font-weight: 600;">Packing List</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Form Section -->
<div style="background: var(--color-bg); padding: 2.5rem 0 4rem;">
  <div class="container" style="max-width: 860px;">

    <!-- Flash errors -->
    <% if(error && error.length > 0){ %>
      <div class="alert alert-danger mb-3"><%= error %></div>
    <% } %>

    <form action="/trip-planner" method="POST" id="tripPlanForm">

      <!-- Card 1: Where & When -->
      <div class="tp-card">
        <div class="tp-card-label">
          <i class="fa-solid fa-location-dot"></i> Where do you want to go?
        </div>

        <div class="tp-field">
          <label class="tp-label">Destination <span style="color: var(--color-cta);">*</span></label>
          <div class="tp-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="destination" class="tp-input" 
              placeholder="e.g. Goa, Manali, Jaipur, Ladakh..." 
              list="wishlistSuggestions" required autocomplete="off" />
          </div>
          <datalist id="wishlistSuggestions">
            <% wishlistDestinations.forEach(dest => { %>
              <option value="<%= dest %>">
            <% }) %>
          </datalist>
          <% if(wishlistDestinations.length > 0){ %>
            <div style="font-size: 0.75rem; color: var(--color-muted); margin-top: 0.3rem;">
              <i class="fa-regular fa-heart me-1" style="color: var(--color-cta);"></i>
              From your wishlist: 
              <% wishlistDestinations.slice(0,3).forEach((d, i) => { %>
                <span class="tp-suggestion" onclick="document.querySelector('[name=destination]').value='<%= d %>'"><%= d %></span><% if(i < Math.min(wishlistDestinations.length,3)-1){ %>, <% } %>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="row g-3">
          <div class="col-md-4">
            <div class="tp-field">
              <label class="tp-label">Total Budget (₹) <span style="color: var(--color-cta);">*</span></label>
              <div class="tp-input-wrap">
                <i class="fa-solid fa-indian-rupee-sign"></i>
                <input type="number" name="totalBudget" class="tp-input" placeholder="15000" min="500" required />
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="tp-field">
              <label class="tp-label">Duration (days) <span style="color: var(--color-cta);">*</span></label>
              <div class="tp-input-wrap">
                <i class="fa-regular fa-calendar"></i>
                <input type="number" name="duration" class="tp-input" placeholder="5" min="1" max="30" required />
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="tp-field">
              <label class="tp-label">Travelers <span style="color: var(--color-cta);">*</span></label>
              <div class="tp-input-wrap">
                <i class="fa-solid fa-users"></i>
                <input type="number" name="travelers" class="tp-input" placeholder="2" min="1" max="20" required />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Interests -->
      <div class="tp-card">
        <div class="tp-card-label">
          <i class="fa-solid fa-heart"></i> What are your interests? <span style="color: var(--color-cta); font-size: 0.8rem;">(select at least one)</span>
        </div>
        <div class="tp-interests-grid">
          <label class="tp-interest-card">
            <input type="checkbox" name="interests" value="adventure" hidden>
            <div class="tp-interest-icon">🏔️</div>
            <div class="tp-interest-name">Adventure</div>
          </label>
          <label class="tp-interest-card">
            <input type="checkbox" name="interests" value="culture" hidden>
            <div class="tp-interest-icon">🏛️</div>
            <div class="tp-interest-name">Culture</div>
          </label>
          <label class="tp-interest-card">
            <input type="checkbox" name="interests" value="food" hidden>
            <div class="tp-interest-icon">🍜</div>
            <div class="tp-interest-name">Food</div>
          </label>
          <label class="tp-interest-card">
            <input type="checkbox" name="interests" value="relaxation" hidden>
            <div class="tp-interest-icon">🌅</div>
            <div class="tp-interest-name">Relaxation</div>
          </label>
        </div>
      </div>

      <!-- Card 3: Optional Details -->
      <div class="tp-card">
        <div class="tp-card-label">
          <i class="fa-solid fa-sliders"></i> Optional Details
          <span style="font-size: 0.75rem; color: var(--color-muted); font-weight: 400; margin-left: 0.5rem;">Leave blank to skip</span>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <div class="tp-field">
              <label class="tp-label">Travelling From (Source City)</label>
              <div class="tp-input-wrap">
                <i class="fa-solid fa-train"></i>
                <input type="text" name="sourceCity" id="sourceCity" class="tp-input" placeholder="e.g. Mumbai, Delhi" />
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="tp-field">
              <label class="tp-label">Plan Label</label>
              <div class="tp-input-wrap">
                <i class="fa-solid fa-tag"></i>
                <input type="text" name="label" class="tp-input" placeholder="e.g. Summer trip with friends" maxlength="60" />
              </div>
            </div>
          </div>
        </div>

        <!-- Transport Preference — hidden until source city filled -->
        <div id="transportField" style="display: none;" class="mt-3">
          <label class="tp-label">Transport Preference</label>
          <div class="tp-transport-grid">
            <label class="tp-transport-option">
              <input type="radio" name="transportPreference" value="cheapest" hidden>
              <div class="tp-transport-icon">🚌</div>
              <div class="tp-transport-name">Cheapest</div>
            </label>
            <label class="tp-transport-option">
              <input type="radio" name="transportPreference" value="fastest" hidden>
              <div class="tp-transport-icon">✈️</div>
              <div class="tp-transport-name">Fastest</div>
            </label>
            <label class="tp-transport-option">
              <input type="radio" name="transportPreference" value="no_preference" hidden>
              <div class="tp-transport-icon">🤷</div>
              <div class="tp-transport-name">No Preference</div>
            </label>
          </div>
        </div>

        <!-- Travel Dates -->
        <div class="row g-3 mt-1">
          <div class="col-md-6">
            <div class="tp-field">
              <label class="tp-label">Check-in Date <span style="font-size: 0.72rem; color: var(--color-muted);">(for weather forecast)</span></label>
              <div class="tp-input-wrap">
                <i class="fa-regular fa-calendar-check"></i>
                <input type="date" name="checkIn" id="checkIn" class="tp-input" />
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="tp-field">
              <label class="tp-label">Check-out Date</label>
              <div class="tp-input-wrap">
                <i class="fa-regular fa-calendar-xmark"></i>
                <input type="date" name="checkOut" id="checkOut" class="tp-input" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="tp-submit-btn" id="submitBtn">
        <span id="btnText">
          <i class="fa-solid fa-wand-magic-sparkles me-2"></i>Generate My Trip Plan
        </span>
        <span id="btnSpinner" style="display: none;">
          <span class="spinner-border spinner-border-sm me-2"></span>
          AI is crafting your plan... (15–20 seconds)
        </span>
      </button>

    </form>
  </div>
</div>

<style>
.tp-card {
  background: var(--color-white);
  border-radius: 16px;
  box-shadow: 0 2px 20px rgba(44,36,22,0.08);
  padding: 1.8rem;
  margin-bottom: 1.2rem;
  border: 1px solid rgba(224,213,200,0.5);
}

.tp-card-label {
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--color-text);
  margin-bottom: 1.2rem;
  padding-bottom: 0.8rem;
  border-bottom: 2px solid #f0e8dc;
}

.tp-card-label i {
  color: var(--color-nav);
  margin-right: 0.4rem;
}

.tp-field { margin-bottom: 0; }

.tp-label {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 0.4rem;
}

.tp-input-wrap {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  background: #faf7f3;
  border: 1.5px solid #e0d5c8;
  border-radius: 10px;
  padding: 0.65rem 1rem;
  transition: border 0.2s, box-shadow 0.2s;
}

.tp-input-wrap:focus-within {
  border-color: var(--color-nav);
  box-shadow: 0 0 0 3px rgba(112,130,56,0.1);
  background: white;
}

.tp-input-wrap i {
  color: var(--color-muted);
  font-size: 0.85rem;
  flex-shrink: 0;
}

.tp-input {
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-main);
  font-size: 0.88rem;
  color: var(--color-text);
  width: 100%;
}

.tp-input::placeholder { color: #b0a090; }

.tp-suggestion {
  color: var(--color-cta);
  cursor: pointer;
  text-decoration: underline;
  font-weight: 500;
}

.tp-suggestion:hover { color: #c9692e; }

/* Interest Cards */
.tp-interests-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.8rem;
}

.tp-interest-card {
  cursor: pointer;
  border: 2px solid #e0d5c8;
  border-radius: 12px;
  padding: 1.2rem 0.8rem;
  text-align: center;
  transition: all 0.2s;
  background: #faf7f3;
}

.tp-interest-card:hover {
  border-color: var(--color-nav);
  background: #f0f4e8;
  transform: translateY(-2px);
}

.tp-interest-card:has(input:checked) {
  border-color: var(--color-nav);
  background: #f0f4e8;
  box-shadow: 0 0 0 3px rgba(112,130,56,0.15);
}

.tp-interest-icon { font-size: 1.8rem; margin-bottom: 0.4rem; }

.tp-interest-name {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-text);
}

/* Transport Options */
.tp-transport-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.8rem;
  margin-top: 0.4rem;
}

.tp-transport-option {
  cursor: pointer;
  border: 2px solid #e0d5c8;
  border-radius: 10px;
  padding: 0.8rem;
  text-align: center;
  transition: all 0.2s;
  background: #faf7f3;
}

.tp-transport-option:hover { border-color: var(--color-nav); background: #f0f4e8; }

.tp-transport-option:has(input:checked) {
  border-color: var(--color-cta);
  background: #fef3e8;
  box-shadow: 0 0 0 3px rgba(224,123,57,0.15);
}

.tp-transport-icon { font-size: 1.4rem; margin-bottom: 0.3rem; }

.tp-transport-name {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--color-text);
}

/* Submit Button */
.tp-submit-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-cta), #c9692e);
  color: white;
  border: none;
  border-radius: 14px;
  padding: 1.1rem;
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
  font-family: var(--font-main);
  transition: all 0.2s;
  box-shadow: 0 4px 20px rgba(224,123,57,0.35);
  margin-top: 0.5rem;
}

.tp-submit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(224,123,57,0.45);
}

.tp-submit-btn:disabled {
  opacity: 0.8;
  cursor: not-allowed;
  transform: none;
}

@media (max-width: 576px) {
  .tp-interests-grid { grid-template-columns: repeat(2, 1fr); }
  .tp-transport-grid { grid-template-columns: repeat(3, 1fr); }
}
</style>

<script>
  // Source city → show transport preference
  document.getElementById("sourceCity").addEventListener("input", function () {
    document.getElementById("transportField").style.display = this.value.trim() ? "block" : "none";
  });

  // Submit → spinner
  document.getElementById("tripPlanForm").addEventListener("submit", function () {
    document.getElementById("btnText").style.display = "none";
    document.getElementById("btnSpinner").style.display = "inline";
    document.getElementById("submitBtn").disabled = true;
  });
</script>
